{
    "version": "0.1.6",
    "description": "Utility tool for converting various files to Markdown",
    "homepage": "https://github.com/microsoft/markitdown",
    "license": "MIT",
    "depends": "main/uv",
    "url": "https://files.pythonhosted.org/packages/18/b7/91fe0e2df07107ab701a15c8ad3213135707e4d6206ae9bd8f457a7ad86a/markitdown-0.1.6.tar.gz",
    "hash": "e5bdbaffd971b29598c7c39ef0e9afce2f08c0751fbfa4e4257678ebaf8cfc7e",
    "extract_dir": "markitdown-0.1.6",
    "installer": {
        "script": [
            "Push-Location $dir",
            "uv venv --python 3.13 venv",
            "uv pip install --python \"$dir\\venv\\Scripts\\python.exe\" \".[all]\" \"markitdown-ocr[llm]==0.1.0\"",
            "$launcher = @'",
            "import argparse",
            "import os",
            "import sys",
            "from pathlib import Path",
            "from markitdown import MarkItDown",
            "from openai import OpenAI",
            "",
            "parser = argparse.ArgumentParser(prog='markitdown-ollama')",
            "parser.add_argument('input', help='Input document')",
            "parser.add_argument('-o', '--output', help='Output Markdown file')",
            "parser.add_argument('-m', '--model', default=os.environ.get('MARKITDOWN_OLLAMA_MODEL', 'qwen3-vl:8b'))",
            "parser.add_argument('--base-url', default=os.environ.get('MARKITDOWN_OLLAMA_URL', 'http://localhost:11434/v1'))",
            "args = parser.parse_args()",
            "",
            "client = OpenAI(base_url=args.base_url, api_key='ollama')",
            "",
            "try:",
            "    models = {m.id for m in client.models.list().data}",
            "except Exception as exc:",
            "    sys.exit(f'Cannot connect to Ollama at {args.base_url}: {exc}')",
            "",
            "if args.model not in models:",
            "    sys.exit(f\"Ollama model '{args.model}' is not installed. Run: ollama pull {args.model}\")",
            "",
            "md = MarkItDown(",
            "    enable_plugins=True,",
            "    llm_client=client,",
            "    llm_model=args.model,",
            ")",
            "",
            "result = md.convert(args.input)",
            "",
            "if args.output:",
            "    Path(args.output).write_text(result.text_content, encoding='utf-8')",
            "else:",
            "    sys.stdout.write(result.text_content)",
            "'@",
            "Set-Content -Path \"$dir\\markitdown-ollama.py\" -Value $launcher -Encoding UTF8",
            "$wrapper = '@echo off`r`n\"%~dp0venv\\Scripts\\python.exe\" \"%~dp0markitdown-ollama.py\" %*'",
            "Set-Content -Path \"$dir\\markitdown-ollama.cmd\" -Value $wrapper -Encoding ASCII",
            "Pop-Location"
        ]
    },
    "bin": [
        "venv\\Scripts\\markitdown.exe",
        "markitdown-ollama.cmd"
    ],
    "checkver": {
        "url": "https://pypi.org/pypi/markitdown/json",
        "regex": "\"filename\":\"markitdown-(?<version>[^\"]+)\\.tar\\.gz\"[\\s\\S]*?\"url\":\"(?<url>https://files\\.pythonhosted\\.org/[^\"]+/markitdown-[^\"]+\\.tar\\.gz)\""
    },
    "autoupdate": {
        "url": "$matchUrl",
        "extract_dir": "markitdown-$version"
    }
}
