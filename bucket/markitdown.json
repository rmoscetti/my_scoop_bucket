{
    "version": "0.1.7",
    "description": "Utility tool for converting various files to Markdown",
    "homepage": "https://github.com/microsoft/markitdown",
    "license": "MIT",
    "depends": "main/uv",
    "url": "https://files.pythonhosted.org/packages/59/93/e8a4af0c47551beb6383e226e840cbc811a577b8096eb385251b3fcc8f62/markitdown-0.1.7.tar.gz",
    "hash": "4d1f3c69cd43b82288fdc3653686d759dcf355ee7c681aa6a855aed98a1e4f44",
    "extract_dir": "markitdown-0.1.7",
    "installer": {
        "script": [
            "Push-Location $dir",
            "uv venv --python 3.13 venv",
            "uv pip install --python \"$dir\\venv\\Scripts\\python.exe\" \".[all]\"",
            "Pop-Location"
        ]
    },
    "bin": "venv\\Scripts\\markitdown.exe",
    "checkver": {
        "url": "https://pypi.org/pypi/markitdown/json",
        "regex": "\"filename\":\"markitdown-(?<version>[^\"]+)\\.tar\\.gz\"[\\s\\S]*?\"url\":\"(?<url>https://files\\.pythonhosted\\.org/[^\"]+/markitdown-[^\"]+\\.tar\\.gz)\""
    },
    "autoupdate": {
        "url": "$matchUrl",
        "extract_dir": "markitdown-$version"
    }
}
